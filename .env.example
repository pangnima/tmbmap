# Kakao Developers > 앱 > 앱 키 > JavaScript 키
VITE_KAKAO_JS_KEY=
# Supabase > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ※ 아래 값은 이 파일이 아니라 Supabase 대시보드 > Edge Functions > Secrets 에 넣습니다 (브라우저에 노출 금지)
# NAVER_CLIENT_ID / NAVER_CLIENT_SECRET : NAVER API HUB(네이버 클라우드) Application 인증 정보 (블로그 후기·홈페이지)
# KAKAO_REST_KEY                        : 카카오 앱 REST API 키 (숙소→가게 차량 시간)
